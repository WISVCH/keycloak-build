# Values in this file are intentionally safe to commit. Copy it to .env before
# starting the development stack, then replace values where needed.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_DB_PASSWORD=keycloak

# The provider is usable immediately with a placeholder value, but actual
# Dienst2 lookups require a reachable Dienst2 instance and a valid API key.
# On Docker Desktop, host.docker.internal reaches a service on your host.
DIENST2_BASE_URL=http://host.docker.internal:8000
DIENST2_API_KEY=replace-with-a-local-dienst2-api-key

# Development credentials registered with the same local callback URL used by
# this stack: http://localhost:8181/realms/ch-dev/broker/<provider>/endpoint
GOOGLE_CLIENT_ID=replace-with-a-google-development-client-id
GOOGLE_CLIENT_SECRET=replace-with-a-google-development-client-secret
SURFCONEXT_CLIENT_ID=replace-with-a-surfconext-test-client-id
SURFCONEXT_CLIENT_SECRET=replace-with-a-surfconext-test-client-secret
